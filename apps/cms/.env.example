# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=pt

# Generate unique values for every environment.
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# MySQL
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=priscila_skincare
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Uploads: "local" for development, "cloudinary" for staging/production.
UPLOAD_PROVIDER=local
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Optional Strapi behavior
WEBHOOKS_POPULATE_RELATIONS=false
CMS_BOOTSTRAP_LOCALES=true
CMS_BOOTSTRAP_PUBLIC_READ=true
CMS_SEED_BASE_DATA=false

# Review moderation bridge (.NET <-> Strapi)
APPLICATION_API_URL=http://localhost:5041
REVIEW_INTEGRATION_SECRET=replace-with-the-same-32-character-secret-used-by-the-api
