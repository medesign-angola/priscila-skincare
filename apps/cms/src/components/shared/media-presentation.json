{
  "collectionName": "components_shared_media_presentations",
  "info": {
    "displayName": "Apresentação de imagem ou vídeo",
    "description": "Imagens e vídeos adaptados ao computador e ao telemóvel"
  },
  "attributes": {
    "desktopImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "placeholder": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "alt": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "focalPointX": {
      "type": "decimal",
      "default": 50,
      "min": 0,
      "max": 100
    },
    "focalPointY": {
      "type": "decimal",
      "default": 50,
      "min": 0,
      "max": 100
    },
    "objectFit": {
      "type": "customField",
      "customField": "global::friendly-select",
      "default": "cover",
      "options": {
        "choices": [
          {
            "value": "cover",
            "label": "Preencher toda a área",
            "description": "A imagem ocupa todo o espaço disponível, mas algumas partes podem ser cortadas."
          },
          {
            "value": "contain",
            "label": "Mostrar a imagem completa",
            "description": "A imagem aparece inteira, mas podem surgir espaços livres nas laterais ou em cima e em baixo."
          }
        ]
      }
    },
    "hasNoise": {
      "type": "boolean",
      "default": false
    }
  }
}
