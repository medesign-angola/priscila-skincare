{
  "collectionName": "components_shared_media_presentations",
  "info": {
    "displayName": "Apresentação de imagem ou vídeo",
    "description": "Imagens e vídeos adaptados ao computador e ao telemóvel"
  },
  "attributes": {
    "desktopImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos"]
    },
    "placeholder": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "alt": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "focalPointX": {
      "type": "decimal",
      "default": 50,
      "min": 0,
      "max": 100
    },
    "focalPointY": {
      "type": "decimal",
      "default": 50,
      "min": 0,
      "max": 100
    },
    "objectFit": {
      "type": "enumeration",
      "enum": ["cover", "contain"],
      "default": "cover"
    },
    "hasNoise": {
      "type": "boolean",
      "default": false
    }
  }
}
