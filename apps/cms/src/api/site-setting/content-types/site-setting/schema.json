{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Configurações do site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true
    },
    "contactEmail": {
      "type": "email"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "newsletterHeadline": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "footerBackground": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "termsUrl": { "type": "string" },
    "privacyUrl": { "type": "string" },
    "defaultCurrency": {
      "type": "enumeration",
      "enum": ["AOA", "EUR"],
      "default": "AOA"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
