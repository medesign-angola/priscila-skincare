{
  "kind": "collectionType",
  "collectionName": "kits",
  "info": {
    "singularName": "kit",
    "pluralName": "kits",
    "displayName": "Kit de produtos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "prices": {
      "type": "component",
      "component": "commerce.prices",
      "repeatable": false,
      "required": true
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "commerce": {
      "type": "component",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      },
      "component": "commerce.product-commerce",
      "repeatable": false
    },
    "thumbnailImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "media": {
      "type": "component",
      "component": "shared.media-presentation",
      "repeatable": false
    },
    "homePresentation": {
      "type": "component",
      "component": "home.kit-presentation",
      "repeatable": false
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "kits"
    },
    "details": {
      "type": "component",
      "component": "catalog.bundle-details",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "relatedProducts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
