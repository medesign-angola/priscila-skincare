{
  "kind": "collectionType",
  "collectionName": "hero_slides",
  "info": {
    "singularName": "hero-slide",
    "pluralName": "hero-slides",
    "displayName": "Banner da página inicial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "headline": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "presentation": {
      "type": "customField",
      "customField": "global::friendly-select",
      "default": "split-right",
      "required": true,
      "options": {
        "choices": [
          {
            "value": "split-right",
            "label": "Imagem dividida à direita",
            "description": "O conteúdo aparece à esquerda e a imagem ocupa o lado direito do banner."
          },
          {
            "value": "cover",
            "label": "Imagem em tela inteira",
            "description": "A imagem preenche todo o banner e o conteúdo é apresentado por cima dela."
          }
        ]
      }
    },
    "media": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-presentation",
      "required": true
    },
    "cta": {
      "type": "dynamiczone",
      "components": [
        "action.product",
        "action.kit",
        "action.collection",
        "action.category",
        "action.internal-page",
        "action.external-link"
      ],
      "max": 1
    },
    "order": {
      "type": "integer",
      "required": true,
      "min": 0
    }
  }
}
