{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Página inicial"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroSlides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hero-slide.hero-slide"
    },
    "featuredProducts": {
      "type": "component",
      "component": "home.product-slot",
      "repeatable": true,
      "max": 4
    },
    "editorialCover": {
      "type": "component",
      "component": "home.editorial-product",
      "repeatable": false
    },
    "editorialGallery": {
      "type": "component",
      "component": "home.editorial-gallery-product",
      "repeatable": false
    },
    "featuredKit": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::kit.kit"
    },
    "featuredCollection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::collection.collection"
    },
    "ingredients": {
      "type": "component",
      "component": "home.ingredients-presentation",
      "repeatable": false
    },
    "testimonials": {
      "type": "component",
      "component": "home.testimonials-presentation",
      "repeatable": false
    },
    "brandPillars": {
      "type": "component",
      "component": "about.pillars-section",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
