{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Produto",
    "description": "Produto disponível no catálogo da loja"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "additionalDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "commerce": {
      "type": "component",
      "repeatable": false,
      "component": "commerce.product-commerce",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "thumbnailImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products",
      "required": true
    },
    "sizes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::size.size",
      "inversedBy": "products"
    },
    "ingredients": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ingredient.ingredient",
      "inversedBy": "products"
    },
    "collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::collection.collection",
      "mappedBy": "products"
    },
    "kits": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::kit.kit",
      "mappedBy": "products"
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "product.benefit",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "benefitsMainMedia": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-presentation"
    },
    "editorial": {
      "type": "component",
      "repeatable": false,
      "component": "product.editorial-copy",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "editorialEnabled": {
      "type": "boolean",
      "default": true
    },
    "editorialMedia": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-presentation"
    },
    "galleryEditorial": {
      "type": "component",
      "repeatable": false,
      "component": "product.editorial-copy",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "galleryEditorialEnabled": {
      "type": "boolean",
      "default": true
    },
    "usageSteps": {
      "type": "component",
      "repeatable": true,
      "component": "product.usage-step",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "usageMedia": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-presentation"
    },
    "results": {
      "type": "component",
      "repeatable": false,
      "component": "product.results",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "product"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
