{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "Página Sobre"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "heroLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "heroHeadline": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "heroDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "heroMedia": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-presentation",
      "required": true
    },
    "brandTimeline": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "brand": {
      "type": "component",
      "repeatable": false,
      "component": "about.brand-section"
    },
    "pillars": {
      "type": "component",
      "repeatable": false,
      "component": "about.pillars-section"
    },
    "founderName": {
      "type": "string"
    },
    "founderBiography": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "founderMedia": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-presentation"
    },
    "founder": {
      "type": "component",
      "repeatable": false,
      "component": "about.founder-section"
    },
    "locations": {
      "type": "component",
      "repeatable": false,
      "component": "about.locations-section"
    },
    "ingredients": {
      "type": "component",
      "repeatable": false,
      "component": "home.ingredients-presentation"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
