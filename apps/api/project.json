{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/api",
  "sourceRoot": "apps/api",
  "tags": ["type:app", "scope:backend"],
  "implicitDependencies": ["backend-application", "backend-infrastructure"],
  "targets": {
    "restore": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "dotnet restore apps/api/PriscilaSkincare.Api.csproj" }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/bin"],
      "options": { "command": "dotnet build apps/api/PriscilaSkincare.Api.csproj --configuration Release --no-restore" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["restore"],
      "options": { "command": "dotnet run --project apps/api/PriscilaSkincare.Api.csproj --no-restore" }
    },
    "database-update": {
      "executor": "nx:run-commands",
      "dependsOn": ["restore"],
      "options": { "command": "dotnet tool restore && dotnet tool run dotnet-ef database update --project packages/backend-infrastructure/PriscilaSkincare.Infrastructure.csproj --startup-project apps/api/PriscilaSkincare.Api.csproj" }
    },
    "migration-add": {
      "executor": "nx:run-commands",
      "dependsOn": ["restore"],
      "options": { "command": "dotnet tool restore && dotnet tool run dotnet-ef migrations add {args.name} --project packages/backend-infrastructure/PriscilaSkincare.Infrastructure.csproj --startup-project apps/api/PriscilaSkincare.Api.csproj --output-dir Persistence/Migrations" }
    }
  }
}
