{
  "name": "backend-application",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "root": "packages/backend-application",
  "sourceRoot": "packages/backend-application",
  "tags": ["type:application", "scope:backend"],
  "implicitDependencies": ["backend-domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/bin"],
      "options": { "command": "dotnet build packages/backend-application/PriscilaSkincare.Application.csproj --configuration Release --no-restore" }
    }
  }
}
