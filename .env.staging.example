# Domínios apontados para o IP da VPS
API_DOMAIN=api-staging.example.com
CMS_DOMAIN=cms-staging.example.com
STOREFRONT_ORIGIN=https://storefront-staging.example.com

# Portas locais usadas pelo Nginx da VPS
API_HOST_PORT=8098
CMS_HOST_PORT=8099

# MySQL: uma instância, bases lógicas separadas e utilizadores próprios
MYSQL_ROOT_PASSWORD=change-me-root
APP_DB_NAME=priscila_app
APP_DB_USER=priscila_app
APP_DB_PASSWORD=change-me-app-db
CMS_DB_NAME=priscila_cms
CMS_DB_USER=priscila_cms
CMS_DB_PASSWORD=change-me-cms-db
PAYMENTS_DB_NAME=priscila_payments
PAYMENTS_DB_USER=priscila_payments
PAYMENTS_DB_PASSWORD=change-me-payments-db

# API .NET
JWT_ISSUER=PriscilaSkincare.Api
JWT_AUDIENCE=PriscilaSkincare.Storefront
JWT_SECRET=change-me-with-at-least-32-characters
AUTH_HASH_SECRET=change-me-with-at-least-32-characters
INTEGRATION_SECRET=change-me-shared-secret-at-least-32-chars
PAYMENTS_INTERNAL_API_KEY=change-me-payments-internal-key-at-least-32-chars
PAYMENTS_PROVIDER=Manual
PAYMENTS_TIMEOUT_SECONDS=15
PAYMENTS_IMAGE=ghcr.io/medesign-angola/priscila-payments-service:latest
NOTIFICATIONS_DB_NAME=priscila_notifications
NOTIFICATIONS_DB_USER=priscila_notifications
NOTIFICATIONS_DB_PASSWORD=change-me-notifications-db
NOTIFICATIONS_INTERNAL_API_KEY=change-me-notifications-internal-key-at-least-32-chars
NOTIFICATIONS_TIMEOUT_SECONDS=15
NOTIFICATIONS_IMAGE=ghcr.io/medesign-angola/priscila-notifications-service:latest
OTP_LIFETIME_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
REFRESH_TOKEN_DAYS=30

# E-mail: mantenha Log até configurar o SMTP oficial
EMAIL_DELIVERY_MODE=Log
EMAIL_PROVIDER=Log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Priscila Skin Care
SMTP_TIMEOUT_SECONDS=30
ORDER_CONFIRMATION_EMAIL_ENABLED=true
EMAIL_SUPPORT_ADDRESS=apoio@example.com
EMAIL_OUTBOX_POLL_SECONDS=10

# Segredos do Strapi (use valores aleatórios e únicos)
STRAPI_APP_KEYS=key-1,key-2,key-3,key-4
STRAPI_API_TOKEN_SALT=change-me
STRAPI_ADMIN_JWT_SECRET=change-me
STRAPI_TRANSFER_TOKEN_SALT=change-me
STRAPI_JWT_SECRET=change-me
STRAPI_ENCRYPTION_KEY=change-me
