# Domínios apontados para o IP da VPS
API_DOMAIN=api-staging.example.com
CMS_DOMAIN=cms-staging.example.com
STOREFRONT_ORIGIN=https://storefront-staging.example.com

# Portas locais usadas pelo Nginx da VPS
API_HOST_PORT=8098
CMS_HOST_PORT=8099

# MySQL: uma instância, duas bases lógicas e utilizadores separados
MYSQL_ROOT_PASSWORD=change-me-root
APP_DB_NAME=priscila_app
APP_DB_USER=priscila_app
APP_DB_PASSWORD=change-me-app-db
CMS_DB_NAME=priscila_cms
CMS_DB_USER=priscila_cms
CMS_DB_PASSWORD=change-me-cms-db

# API .NET
JWT_ISSUER=PriscilaSkincare.Api
JWT_AUDIENCE=PriscilaSkincare.Storefront
JWT_SECRET=change-me-with-at-least-32-characters
AUTH_HASH_SECRET=change-me-with-at-least-32-characters
INTEGRATION_SECRET=change-me-shared-secret-at-least-32-chars
OTP_LIFETIME_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
REFRESH_TOKEN_DAYS=30

# E-mail: mantenha Log até configurar o SMTP oficial
EMAIL_DELIVERY_MODE=Log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Priscila Skin Care
SMTP_TIMEOUT_SECONDS=30

# Segredos do Strapi (use valores aleatórios e únicos)
STRAPI_APP_KEYS=key-1,key-2,key-3,key-4
STRAPI_API_TOKEN_SALT=change-me
STRAPI_ADMIN_JWT_SECRET=change-me
STRAPI_TRANSFER_TOKEN_SALT=change-me
STRAPI_JWT_SECRET=change-me
STRAPI_ENCRYPTION_KEY=change-me
